# Top-level monorepo .gitignore.
# Each subdirectory (frontend/, backend/) also has its own .gitignore.

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Node
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Vite / React build artifacts
dist/
build/
coverage/

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
*/.env
*/.env.local

# Mobile (Expo)
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Python
__pycache__/
*.py[cod]

# Logs
*.log
logs/
