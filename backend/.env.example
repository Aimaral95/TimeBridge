# Copy this file to `.env` and fill in real values.
# `.env` is loaded automatically by dotenv at server start.

# ── Server ──────────────────────────────────────────────
PORT=5050
JWT_SECRET=please-change-me

# ── Postgres ───────────────────────────────────────────
# Either set DATABASE_URL (single connection string) or the individual
# PG* fields below. DATABASE_URL wins if both are set.
# Example: postgresql://user:password@localhost:5432/TimeBridge
# DATABASE_URL=
# DATABASE_SSL=false   # set "true" for hosted providers that require SSL

PGUSER=postgres
PGHOST=localhost
PGDATABASE=TimeBridge
PGPASSWORD=change-me
PGPORT=5432

# Where the FRONTEND lives. The reset-password email link points here.
# Vite dev: http://localhost:5173
# Render frontend example: https://timebridge.onrender.com
APP_URL=http://localhost:5173

# ── SMTP (for forgot-password emails) ──────────────────
# If these are NOT set, the backend prints the reset link to the
# server console instead of sending a real email — handy for demos.
#
# For Gmail, create an App Password at
#   https://myaccount.google.com/apppasswords
# (2-step verification must be on) and use it as SMTP_PASS.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="TimeBridge <you@gmail.com>"

# ── Google Calendar OAuth (optional) ────────────────────
# When these are set, Settings → Integrations → "Connect Google Calendar"
# becomes active. When unset, the same row shows a "Setup required" pill.
#
# Setup steps:
#   1. https://console.cloud.google.com → create a project
#   2. APIs & Services → Library → enable "Google Calendar API"
#   3. APIs & Services → Credentials → Create credentials → OAuth client ID
#      Application type: Web application
#      Local authorised redirect URI: http://localhost:5050/integrations/google/callback
#      Render authorised redirect URI: https://timebridge-api.onrender.com/integrations/google/callback
#      Local authorised JavaScript origin: http://localhost:5173
#      Render authorised JavaScript origin: https://timebridge.onrender.com
#   4. OAuth consent screen → User type: External → fill in basics → Save
#      → Test users → add your own Gmail
#   5. Copy the client ID + secret here.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5050/integrations/google/callback
